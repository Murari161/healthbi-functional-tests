# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# The live Health BI "report-browser" app (no trailing slash).
HEALTHBI_BASE_URL=https://dashboards.health.go.ug/report-browser

# API base. The frontend's filter endpoints are absolute paths like
# "/api/filters/districts?...", so this is usually ORIGIN + "/api".
# VALIDATE this against the live site during first setup.
HEALTHBI_API_BASE=https://dashboards.health.go.ug/api

# --- Login (OPTIONAL) ---
# Two ways to authenticate for the one-time session capture:
#   1. MANUAL (recommended): leave these blank. `npm run prepare-run` opens a
#      browser window and waits for you to sign in by hand (MFA is fine).
#      Nothing is stored in a file.
#   2. AUTOMATED: set both and the Keycloak form is filled for you.
# Either way, use a dedicated NORMAL (non-admin) QA account so the suite only
# sees what a normal user sees. Credentials, if set, are only typed into the
# Keycloak page — never logged or written to results.
HEALTHBI_USER=
HEALTHBI_PASS=

# --- Filter matrix tuning (all optional; defaults shown) ---
# ofat  = one-filter-at-a-time (fast, default)
# deep  = full factorial of sampled values (exhaustive, slow)
MATRIX_MODE=ofat
MAX_YEARS=2
MAX_MONTHS=2
MAX_DISTRICTS=2
MAX_FACILITIES=2
MAX_CUSTOM_VALUES=2

# Scope: "all" or a comma-separated list of report ids
# e.g. REPORT_SCOPE=community/wash-report,Programs/Malaria/malaria-monthly-stock-status
REPORT_SCOPE=all
