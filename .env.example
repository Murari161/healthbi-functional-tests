# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in the values. `.env` is gitignored.
# ---------------------------------------------------------------------------

# The live Health BI "report-browser" app (no trailing slash).
HEALTHBI_BASE_URL=https://dashboards.health.go.ug/report-browser

# API base. The frontend's filter endpoints are absolute paths like
# "/api/filters/districts?...", so this is usually ORIGIN + "/api".
# VALIDATE this against the live site during first setup.
HEALTHBI_API_BASE=https://dashboards.health.go.ug/api

# --- Normal (non-admin) test user for the one-time Keycloak login ---
# Use a dedicated QA account, NOT a personal/admin login, so the suite only
# sees what a normal user sees. These are read by scripts/prepare.ts and
# filled into the Keycloak form; they never leave your machine.
HEALTHBI_USER=
HEALTHBI_PASS=

# --- Filter matrix tuning (all optional; defaults shown) ---
# ofat  = one-filter-at-a-time (fast, default)
# deep  = full factorial of sampled values (exhaustive, slow)
MATRIX_MODE=ofat
MAX_YEARS=2
MAX_MONTHS=2
MAX_DISTRICTS=2
MAX_FACILITIES=2
MAX_CUSTOM_VALUES=2

# Scope: "all" or a comma-separated list of report ids
# e.g. REPORT_SCOPE=community/wash-report,Programs/Malaria/malaria-monthly-stock-status
REPORT_SCOPE=all
